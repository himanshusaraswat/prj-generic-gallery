{
  "name": "gallery",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "node scripts/inject-env.mjs && ng build --configuration production",
    "test": "npm run test:unit && npm run test:visual",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "typecheck": "tsc --project tsconfig.app.json --noEmit",
    "format:check": "prettier --check 'src/**/*.{ts,html,scss,json}'",
    "format:fix": "prettier --write 'src/**/*.{ts,html,scss,json}'",
    "deploy": "ng build --configuration production && firebase deploy -P default",
    "hosting-emulator": "firebase use --project gallery && firebase emulators:start --only hosting",
    "check:drift": "node ../infra-cloud-orchestrator/scripts/check-doc-drift.mjs",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/router": "^22.2.5",
    "bootstrap": "^5.1.3",
    "canvas-confetti": "^1.6.0",
    "firebase": "^12.18.0",
    "ngx-infinite-scroll": "^19.0.0",
    "rxfire": "^6.0.5",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2202.6",
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@types/canvas-confetti": "^1.6.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.7",
    "ts-node": "~8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
